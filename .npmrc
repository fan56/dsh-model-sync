; The devDependencies pin @deepseek-ai packages to the versions shipped by the
; dsh host (0.1.0-rc.x), which cannot satisfy the 0.1.1-rc.x peer ranges of
; newer @deepseek-ai packages such as dsh-commands (types-only devDep). Keep
; npm v6 peer semantics so plain `npm install` works.
legacy-peer-deps=true
