; The devDependencies pin @deepseek-ai packages to the exact versions shipped
; by the dsh host (0.1.2-alpha.3). Those packages declare peers of their own
; (dsh-brand, dsh-session, …) that this repo never imports; keep npm v6 peer
; semantics so npm does not auto-install them and plain `npm install` works.
; scripts/link-dsh-closure.mjs re-points node_modules/@deepseek-ai/* at a real
; dsh install's closure when one is available.
legacy-peer-deps=true
