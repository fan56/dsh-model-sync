{
  "name": "@aiwayds/dsh-model-sync",
  "version": "0.9.0",
  "description": "dsh plugin: keep llm-pi-ai provider routes' model lists in step with the pi.dev gateway, written through the official settings seam",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "./icon.svg",
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "model",
    "sync",
    "catalog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-model-sync.git"
  },
  "homepage": "https://github.com/fan56/dsh-model-sync",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "icon.svg",
    "locale/*.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/live-catalog.test.mjs test/diff.test.mjs test/translate.test.mjs test/writer.test.mjs test/writer-overrides.test.mjs test/remote-catalog.test.mjs test/provider-native.test.mjs test/serviceability.test.mjs test/command.test.mjs test/real-cordis.test.mjs test/route-credential.test.mjs test/legacy-import.test.mjs test/packaged-upgrade.test.mjs test/opencode-go-source.test.mjs test/opencode-go-grouping.test.mjs test/opencode-go-diagnose.test.mjs test/opencode-go-planner.test.mjs test/opencode-go-writer.test.mjs test/opencode-go-store.test.mjs test/opencode-go-round.test.mjs test/opencode-go-scheduler.test.mjs test/opencode-go-migration.test.mjs test/opencode-go-migration-gate.test.mjs test/opencode-go-migrate.test.mjs test/opencode-go-profile-isolation.test.mjs test/opencode-status.test.mjs",
    "smoke": "node scripts/smoke-boot.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
      "@deepseek-ai/dsh-session-projection": "0.2.2-rc.2"
    }
  }
}
